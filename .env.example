# Betriebsmodus: paper (Simulation mit echten Kursen) oder live (echtes Geld)
TRADING_MODE=paper

# Nur fuer live: muss auf true stehen, sonst startet der Bot nicht im Live-Modus
LIVE_TRADING_CONFIRMED=false

# API-Zugang der Boerse (nur fuer live noetig; Rechte: Spot-Handel, KEIN Withdrawal!)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Bitget, OKX, KuCoin und Coinbase brauchen zusaetzlich die Passphrase, die du beim Anlegen des Keys vergeben hast
EXCHANGE_API_PASSWORD=

# Nur fuer die KI-Strategie claude_advisor: Zugang zur Anthropic-API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional: Telegram-Benachrichtigungen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
